APP_NAME="RO Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ro-staging.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ro
DB_USERNAME=ro
DB_PASSWORD=

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# FP Management. Production opt-in; keep true only after migrations, grants,
# and secrets are verified. Never commit a populated .env to Git.
FP_ENABLED=true
FP_BUSINESS_TIMEZONE=Asia/Jakarta
FP_NIK_LOOKUP_KEY=
FP_NIK_LOOKUP_KEY_ID=
# Runtime database role that receives FP production grants. Must match DB_USERNAME.
FP_DB_APP_ROLE=ro
FP_STORAGE_ADAPTER=local
FP_USER_MANAGEMENT_ENABLED=false
FP_ANNUAL_NIP_EMAIL_ENABLED=false
FP_USER_ROLES_ENABLED=false
FP_RECRUITMENT_TEAM_ENABLED=false
FP_ORGANIZATION_ENABLED=false
FP_OPTIONAL_ONBOARDING_ENABLED=false

# Hanya isi sementara saat menjalankan perintah import MariaDB -> PostgreSQL.
# Jangan commit nilai asli, dump SQL, atau .env lokal ke repository.
LEGACY_MYSQL_HOST=
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=
LEGACY_MYSQL_USERNAME=
LEGACY_MYSQL_PASSWORD=

# Keycloak/JWT receiver: accept only signed service tokens.
API_JWT_ISSUER=https://keycloak-staging.example.com/realms/vif
API_JWT_DISCOVERY_URL=https://keycloak-staging.example.com/realms/vif/.well-known/openid-configuration
API_JWT_AUDIENCES=ro-service,iwacs-api

# RO -> IWACS. Create a dedicated Keycloak client named ro-service and put
# its secret only in Dokploy, never in Git.
IWACS_RO_SYNC_ENABLED=false
IWACS_RO_SYNC_API_URL=https://iwacs-staging.example.com/api/v1/integrations/ro/users
IWACS_RO_LOOKUP_API_URL=https://iwacs-staging.example.com/api/v1/integrations/ro/users/lookup
IWACS_RO_SYNC_DISCOVERY_URL=https://keycloak-staging.example.com/realms/vif/.well-known/openid-configuration
IWACS_RO_SYNC_CLIENT_ID=ro-service
IWACS_RO_SYNC_CLIENT_SECRET=

# Browser SSO from IWACS. Mount the matching IWACS public key at this path.
PORTAL_APP_URL=https://iwacs-staging.example.com
SSO_EXPECTED_ISSUER=https://iwacs-staging.example.com
SSO_EXPECTED_AUDIENCE=ro
SSO_PUBLIC_KEY_PATH=storage/app/keys/iwacs-public.pem
SSO_TOKEN_TTL=120
SSO_LEEWAY_SECONDS=5
SSO_REPLAY_TTL=120
