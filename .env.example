APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Queue publication and other background work through the deployment worker.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Optional local RO <-> IWACS synchronization. Values with secrets remain
# local and must never be committed.
API_JWT_ISSUER=http://localhost:8080/realms/vif
API_JWT_DISCOVERY_URL=http://localhost:8080/realms/vif/.well-known/openid-configuration
API_JWT_AUDIENCES=ro-service,iwacs-api
IWACS_RO_SYNC_ENABLED=false
IWACS_RO_SYNC_API_URL=http://127.0.0.1:8000/api/v1/integrations/ro/users
IWACS_RO_LOOKUP_API_URL=http://127.0.0.1:8000/api/v1/integrations/ro/users/lookup
IWACS_RO_SYNC_DISCOVERY_URL=http://localhost:8080/realms/vif/.well-known/openid-configuration
IWACS_RO_SYNC_CLIENT_ID=ro-service
IWACS_RO_SYNC_CLIENT_SECRET=

# Browser SSO from IWACS. The public key may be shared; never copy its private pair.
PORTAL_APP_URL=http://localhost:8000
SSO_EXPECTED_ISSUER=http://localhost:8000
SSO_EXPECTED_AUDIENCE=ro
SSO_PUBLIC_KEY_PATH=storage/app/keys/iwacs-public.pem
SSO_TOKEN_TTL=120
SSO_LEEWAY_SECONDS=5
SSO_REPLAY_TTL=120

# FP Management. Explicit operator opt-in; works in local and production after migrations/grants.
FP_ENABLED=false
FP_BUSINESS_TIMEZONE=Asia/Jakarta
# Generate and store these outside Git before enabling FP in production.
FP_NIK_LOOKUP_KEY=
FP_NIK_LOOKUP_KEY_ID=
# Runtime database role that receives FP production grants. Defaults to DB_USERNAME.
FP_DB_APP_ROLE=
FP_USER_MANAGEMENT_ENABLED=false
FP_ANNUAL_NIP_EMAIL_ENABLED=false
FP_USER_ROLES_ENABLED=false
FP_RECRUITMENT_TEAM_ENABLED=false
FP_ORGANIZATION_ENABLED=false
FP_OPTIONAL_ONBOARDING_ENABLED=false

# Private document storage. Keep local until the operator switches to Nextcloud.
FP_STORAGE_ADAPTER=local

# F3.9 private Nextcloud revisions. Keep disabled until operator acceptance.
# Use a dedicated non-admin account and an App Password from its Security settings.
NEXTCLOUD_ENABLED=false
NEXTCLOUD_BASE_URL=https://cloud.viffx.com
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_ROOT_FOLDER=Victory-FP-Management
# Optional legacy overrides. When empty, the values above are reused.
FP_NEXTCLOUD_ENDPOINT=
FP_NEXTCLOUD_USER=
FP_NEXTCLOUD_PASSWORD=
